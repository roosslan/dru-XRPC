<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <!-- ==================== Подключение к Drupal XML-RPC ==================== -->
    <add key="Drupal.ServiceUrl" value="http://trade.vehicle.kamaz.org/services/xmlrpc" />
    <add key="Drupal.ServiceDomain" value="trade_vehicle_kamaz_org" />
    <add key="Drupal.ServiceKey" value="3a4e9665d1eb6bb47d14309e6691ea1f" />
    <add key="Drupal.UserName" value="rasa" />
    <!-- Пароль здесь не хранится: пустое значение -> программа спросит при подключении -->
    <add key="Drupal.Password" value="" />

    <!-- ==================== Файлы Excel ====================
         Относительные пути считаются от папки приложения (bin\Debug). -->
    <add key="Excel.New" value="new.xlsx" />
    <add key="Excel.Special" value="special.xlsx" />
    <add key="Excel.Parts" value="parts.xlsx" />
  </appSettings>
</configuration>
